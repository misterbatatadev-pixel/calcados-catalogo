    {
      "parameters": {
        "jsCode": "const search = $input.first().json;\nconst previous = $('Normalizar mensagem').first().json;\nconst products = search.products ?? [];\nconst first = products[0] ?? {};\nconst sizeList = (first.sizes ?? []).map((item) => `${item.size} (${item.quantity} un.)`).join(', ');\n\nlet text = search.reply;\nif (products.length) {\n  text += `\\n\\nTenho essa primeira opcao para voce:`;\n  text += `\\nCOD ${first.code} - ${first.priceText}`;\n  text += `\\nTamanhos: ${sizeList}`;\n  text += `\\n\\nSe quiser comprar, responda: quero o tamanho 39`;\n}\n\nreturn [{\n  json: {\n    number: previous.number,\n    customerMessage: previous.message,\n    text,\n    image: first.whatsappImageUrl ?? first.absoluteImageUrl ?? '',\n    productKey: first.productKey ?? '',\n    code: first.code ?? '',\n    products,\n  },\n}];"
      },
