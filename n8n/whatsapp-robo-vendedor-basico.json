    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body ?? $input.first().json;\nconst data = body.data ?? body;\nconst message = data.message ?? data;\nconst key = data.key ?? message.key ?? {};\n\nconst remoteJid = key.remoteJid ?? data.remoteJid ?? body.remoteJid ?? '';\nconst number = String(remoteJid || data.from || body.from || '').replace(/@.*/, '').replace(/\\D/g, '');\nconst text = message.conversation\n  ?? message.extendedTextMessage?.text\n  ?? data.text\n  ?? body.text\n  ?? body.message\n  ?? '';\n\nreturn [{\n  json: {\n    raw: body,\n    number,\n    message: String(text).trim(),\n    isFromMe: Boolean(key.fromMe),\n  },\n}];"
      },
